# Copy this to scripts/release.env (gitignored) and fill in YOUR GPG signing
# key, then `scripts/release.sh launchpad` will sign uploads with it.
#
# Find your key id and fingerprint with:
#   gpg --list-secret-keys --keyid-format=long
# The key id is the part after "rsa4096/"; the fingerprint is the 40-hex-char
# line printed under "sec".
SUPER_LOG_SIGN_KEY=YOUR_GPG_KEY_ID           # e.g. 1234ABCD5678EF90
SUPER_LOG_SIGN_FPR=YOUR_GPG_FINGERPRINT      # e.g. 40 hex chars, no spaces

# Optional overrides (defaults shown):
# SUPER_LOG_PPA=ppa:super-log/stable
# SUPER_LOG_SERIES=noble

# Publish targets for the homebrew and vcpkg stages. Not secrets - local paths
# to clones you can push. If unset, those stages update the formula/port in this
# repo and stop, rather than guess where to push.
#   SUPER_LOG_TAP_REPO=/path/to/homebrew-tap     # your Homebrew tap clone (has Formula/)
#   SUPER_LOG_VCPKG_REPO=/path/to/vcpkg-fork      # your vcpkg registry fork clone (has ports/)
