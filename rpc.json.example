      "url": "https://REPLACE.matic.quiknode.pro/REPLACE/"
    },
    {
      "chain": "polygon",
      "provider": "alchemy",
      "url": "https://polygon-mainnet.g.alchemy.com/v2/REPLACE"
    },
    {
      "chain": "bsc",
      "provider": "quicknode",
      "url": "https://REPLACE.bsc.quiknode.pro/REPLACE/"
    },
    {
      "chain": "bsc",
      "provider": "publicnode",
      "url": "https://bsc-rpc.publicnode.com"
    },
    {
      "chain": "avalanche",
      "provider": "quicknode",
      "url": "https://REPLACE.avalanche-mainnet.quiknode.pro/REPLACE/ext/bc/C/rpc"
