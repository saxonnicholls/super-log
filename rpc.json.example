    },
    {
      "chain": "bitcoin",
      "provider": "quicknode",
      "kind": "bitcoin",
      "url": "https://REPLACE.btc.quiknode.pro/REPLACE/"
    },
    {
      "chain": "bitcoin",
      "provider": "mempool",
