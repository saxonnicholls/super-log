{
  "//": "Copy to rpc.json (GITIGNORED - RPC URLs carry provider keys). Two providers per chain is the point: DOWN or STALLED shows which one to fail away from. Replace each REPLACE with your key/subdomain; delete providers you do not use. kind defaults to evm; solana/tron/bitcoin set explicitly. The publicnode/mempool/trongrid rows work with no key.",
  "url": "http://127.0.0.1:7333",
  "interval": 60,
  "stall": 120,
  "endpoints": [
    {
      "chain": "ethereum",
      "provider": "quicknode",
      "url": "https://REPLACE.quiknode.pro/REPLACE/"
    },
    {
      "chain": "ethereum",
      "provider": "alchemy",
      "url": "https://eth-mainnet.g.alchemy.com/v2/REPLACE"
    },
    {
