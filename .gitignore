# Build trees
build/
build-*/
cmake-build-*/

# JS
node_modules/
dist/
*.tsbuildinfo

# Rust
sdk/rust/target/
Cargo.lock

# OS / editor
.DS_Store
# Ignore local VS Code state, but SHIP the starter MCP config so cloning the
# repo is the install (matches .cursor/, .codex/, .zed/). A blanket .vscode/
# can't be re-included per-file, so exclude its contents and add mcp.json back.
.vscode/*
!.vscode/mcp.json
.idea/
compile_commands.json

# Runtime artefacts
imgui.ini
superlog-journal/
logs/

# Expo / React Native
.expo/

# clangd
.cache/

# Fleet config: real hostnames and keys, never committed
fleet.json

# Gas monitor config: a labelled list of operational keys is a map for an
# attacker even when every address is public on chain
gas.json

# Real credentials: RPC URLs carry provider keys. .env.example is the template.
.env

# Alert rules: may carry a webhook URL, which is a credential
alerts.json

# Lake (Lean) build artefacts
.lake/

# Fortran build artefacts
*.mod
*.smod

# The working ledger: internal notes, real host names, what is verified
# and what is not. Useful to whoever is building this, not to the public.
HANDOFF.md

# Agent/editor session state - local to whoever is working, not the project
.claude/

# Python bytecode - importing the SDK once leaves this behind
__pycache__/
*.py[cod]

# The alarm gateway's live URL roster - ephemeral, semi-sensitive
endpoints.env
endpoints.json

# working docs, not for the public repo
INSTALLERS.md
rpc.json

# built packages
packaging/deb/*.deb
build-deb/
build-inst/

# the Homebrew tap is its own repo, cloned here for convenience
homebrew-tap/
packaging/rpm/*.rpm
build-rpm/

# release signing identity (personal)
scripts/release.env
CLAUDE.md

# MCPB Claude Desktop bundle (built by packaging/mcpb/build-mcpb.sh, attached to the release)
packaging/mcpb/*.mcpb

# Java integration build/test libraries (fetched by sdk/java/integrations/fetch-libs.sh)
sdk/java/.libs/

# Java Maven-Central build outputs (the jars/sigs are release artefacts)
sdk/java/publish/**/target/

# C# demo build outputs - regenerated by `dotnet build`, never source
demo/csharp/bin/
demo/csharp/obj/

# The VS Code extension - held back until it has been tested in a running
# editor (the rail icon, build/debug capture). Remove this line to ship it.
editors/
