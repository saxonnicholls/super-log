# super-log environment
#
# Copy to .env and paste your own values. .env is gitignored and must stay
# that way: an RPC URL with a provider key in it IS a credential - anyone
# holding it can spend your quota, and on some plans read your usage.
#
# Naming follows the convention used across these projects:
#   <CHAIN>_RPC_URL            the endpoint the chain watcher dials
#   <CHAIN>_QUICKNODE_RPC_URL  a second provider for the same chain
#   <CHAIN>_EXPLORER_URL       used to build a human link for a tx
# Anything unset is simply not watched, so a fresh clone with no .env is a
# working bench with no chain streams rather than a broken one.

# ---------------------------------------------------------------- the hub
SUPER_LOG_URL=http://127.0.0.1:7333
# 127.0.0.1 keeps the hub on this machine. 0.0.0.0 lets phones and other
# machines reach it - there is no auth, so only on a network you trust.
SUPER_LOG_BIND=127.0.0.1

# ------------------------------------------------------------ chain watch
# Which chains the watcher dials. Comma-separated, names matching the
# prefixes below: ethereum,base,polygon,arbitrum,optimism
SUPER_LOG_CHAINS=

# Addresses to watch, as label=0xaddress pairs, comma-separated. The label
# becomes the topic: chain.<network>.<label>
#   SUPER_LOG_WATCH=treasury=0xabc...,hotwallet=0xdef...
SUPER_LOG_WATCH=

# Poll interval when the endpoint has no websocket (seconds).
SUPER_LOG_CHAIN_POLL=12

# ------------------------------------------------------------- endpoints
# wss:// endpoints are preferred - the watcher subscribes instead of
# polling, which is cheaper on your quota and lower latency. https:// works
# and falls back to polling automatically.
ETHEREUM_RPC_URL=
ETHEREUM_QUICKNODE_RPC_URL=
ETHEREUM_EXPLORER_URL=https://etherscan.io

BASE_RPC_URL=
BASE_QUICKNODE_RPC_URL=
BASE_EXPLORER_URL=https://basescan.org

POLYGON_RPC_URL=
POLYGON_QUICKNODE_RPC_URL=
POLYGON_EXPLORER_URL=https://polygonscan.com

ARBITRUM_RPC_URL=
ARBITRUM_QUICKNODE_RPC_URL=
ARBITRUM_EXPLORER_URL=https://arbiscan.io

OPTIMISM_RPC_URL=
OPTIMISM_QUICKNODE_RPC_URL=
OPTIMISM_EXPLORER_URL=https://optimistic.etherscan.io

# Testnets, handy for proving the watcher works without spending anything.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Some providers key on an account rather than per-URL.
ALCHEMY_API_KEY=
