# super-log environment
#
# Copy to .env and paste your own values. .env is gitignored and must stay
# that way: an RPC URL with a provider key in it IS a credential - anyone
# holding it can spend your quota, and on some plans read your usage.
#
# Naming follows the convention used across these projects:
#   <CHAIN>_RPC_URL            the endpoint the chain watcher dials
#   <CHAIN>_QUICKNODE_RPC_URL  a second provider for the same chain
#   <CHAIN>_EXPLORER_URL       used to build a human link for a tx
# Anything unset is simply not watched, so a fresh clone with no .env is a
# working bench with no chain streams rather than a broken one.

# ---------------------------------------------------------------- the hub
SUPER_LOG_URL=http://127.0.0.1:7333
# 127.0.0.1 keeps the hub on this machine. 0.0.0.0 lets phones and other
# machines reach it - there is no auth, so only on a network you trust.
SUPER_LOG_BIND=127.0.0.1

# ------------------------------------------------------- development mode
# DEVELOPMENT xor PRODUCTION, the rule every SDK here follows: a consumer
# declares exactly one and there is no default, because deciding is the
# point. The compiled SDKs declare it at build time; the shell producer
# (tailers/bin/superlog-log) reads it from here, so a bench decides once.
# Set it to production and nothing is sent until SUPERLOG_PROD_POLICY says
# a level to ship - that asymmetry is the security posture, not an
# oversight.
SUPERLOG_MODE=development
# SUPERLOG_DEV_POLICY=TRACE
# SUPERLOG_PROD_POLICY=OFF

# ------------------------------------------------------------ chain watch
# Which chains the watcher dials. Comma-separated, names matching the
# prefixes below: ethereum,base,polygon,arbitrum,optimism
SUPER_LOG_CHAINS=

# Addresses to watch, as label=0xaddress pairs, comma-separated. The label
# becomes the topic: chain.<network>.<label>
#   SUPER_LOG_WATCH=treasury=0xabc...,hotwallet=0xdef...
SUPER_LOG_WATCH=

# Poll interval when the endpoint has no websocket (seconds).
SUPER_LOG_CHAIN_POLL=12

# ------------------------------------------------------------- endpoints
# wss:// endpoints are preferred - the watcher subscribes instead of
# polling, which is cheaper on your quota and lower latency. https:// works
# and falls back to polling automatically.
ETHEREUM_RPC_URL=
ETHEREUM_QUICKNODE_RPC_URL=
ETHEREUM_EXPLORER_URL=https://etherscan.io

BASE_RPC_URL=
BASE_QUICKNODE_RPC_URL=
BASE_EXPLORER_URL=https://basescan.org

POLYGON_RPC_URL=
POLYGON_QUICKNODE_RPC_URL=
POLYGON_EXPLORER_URL=https://polygonscan.com

ARBITRUM_RPC_URL=
ARBITRUM_QUICKNODE_RPC_URL=
ARBITRUM_EXPLORER_URL=https://arbiscan.io

OPTIMISM_RPC_URL=
OPTIMISM_QUICKNODE_RPC_URL=
OPTIMISM_EXPLORER_URL=https://optimistic.etherscan.io

BSC_RPC_URL=
BSC_QUICKNODE_RPC_URL=
BSC_EXPLORER_URL=https://bscscan.com

AVALANCHE_RPC_URL=
AVALANCHE_QUICKNODE_RPC_URL=
AVALANCHE_EXPLORER_URL=https://snowtrace.io

# Only EVM chains are listed here: the watcher speaks Ethereum JSON-RPC, so
# Solana and Tron endpoints would not work even though the same .env may
# carry them for other tools.

# Testnets, handy for proving the watcher works without spending anything.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Some providers key on an account rather than per-URL.
ALCHEMY_API_KEY=

# Cloudflare. Only needed for HISTORICAL Workers logs; `npm run cf` tails a
# Worker live using wrangler's own login and needs nothing here. The token
# wants the "Workers Observability" permission, account-scoped - note that
# the sibling telemetry endpoints document WRITE rather than read, so a
# read-only token may 403.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Stripe. `npm run stripe` uses the Stripe CLI's own login, so nothing is
# needed here either - `stripe login`, or `stripe login --project-name NAME`
# for each additional account. Name them here to have the demo pick them up.
SUPER_LOG_STRIPE_ACCOUNTS=

# ------------------------------------------------------------ alarm gateway
# superlog-alarm: the public webhook production fires alarms at (npm run
# alarm). The token is the whole auth story - keep it out of the repo.
SUPER_LOG_ALARM_TOKEN=
# A stable hostname turns the throwaway quick tunnel into a NAMED Cloudflare
# tunnel, auto-provisioned via the API. Needs the three CLOUDFLARE_* values
# above plus CLOUDFLARE_ZONE_ID, and the token needs Zone -> DNS -> Edit.
SUPER_LOG_ALARM_HOSTNAME=
CLOUDFLARE_ZONE_ID=
# cloudflare | ngrok | zrok | none
SUPER_LOG_ALARM_TUNNEL=cloudflare
# Channels for inbound alarms, comma-separated (superlog-alert --channels
# lists the roster and what each missing channel needs)
SUPER_LOG_ALARM_NOTIFY=desktop

# ----------------------------------------------------- notification channels
# One registry serves superlog-alert and superlog-alarm. Configure what you
# use; everything else reports itself unconfigured rather than failing.
SUPER_LOG_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
SUPER_LOG_ALERT_EMAIL=
