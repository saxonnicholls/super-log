{
  "name": "super-log",
  "version": "0.1.0",
  "private": true,
  "description": "One hub for every log stream on the dev bench",
  "author": "Saxon Herschel Nicholls",
  "workspaces": [
    "sdk/js/packages/*",
    "tailers",
    "viewer/react",
    "demo/js"
  ],
  "scripts": {
    "viewer": "npm run dev --workspace @super-log/viewer-react",
    "tail:android": "node tailers/bin/superlog-tail.mjs android",
    "tail:ios-sim": "node tailers/bin/superlog-tail.mjs ios-sim",
    "tail:os": "node tailers/bin/superlog-tail.mjs os",
    "tail:ssh": "node tailers/bin/superlog-tail.mjs ssh",
    "tail:file": "node tailers/bin/superlog-tail.mjs file",
    "tail:apps": "node tailers/bin/superlog-tail.mjs apps",
    "tail:app": "node tailers/bin/superlog-tail.mjs app",
    "journal": "node tailers/bin/superlog-journal.mjs",
    "fleet": "node tailers/bin/superlog-fleet.mjs",
    "search": "node tailers/bin/superlog-search.mjs",
    "replay": "node tailers/bin/superlog-replay.mjs",
    "net": "node tailers/bin/superlog-net.mjs",
    "mcp": "node sdk/js/packages/mcp/bin/superlog-mcp.mjs",
    "demo": "./demo/run.sh",
    "demo:ios": "node demo/js/clock.mjs ios",
    "demo:android": "node demo/js/clock.mjs android",
    "demo:web": "node demo/web/serve.mjs",
    "check": "npm run check --workspace @super-log/client && npm run build --workspace @super-log/viewer-react",
    "chain": "node tailers/bin/superlog-chain.mjs",
    "dns": "node tailers/bin/superlog-dns.mjs",
    "ports": "node tailers/bin/superlog-ports.mjs",
    "build": "node tailers/bin/superlog-build.mjs",
    "vitals": "node tailers/bin/superlog-vitals.mjs",
    "alert": "node tailers/bin/superlog-alert.mjs",
    "demo:shell": "./demo/shell/clock.sh",
    "demo:python": "python3 demo/python/clock.py",
    "demo:swift": "swift run --package-path demo/swift/clock clock",
    "demo:go": "cd demo/go && go run -ldflags=-linkmode=external .",
    "demo:java": "javac -d /tmp/superlog-java $(find sdk/java -name \"*.java\") demo/java/Clock.java && java -cp /tmp/superlog-java Clock",
    "demo:fortran": "gfortran -cpp -DDEVELOPMENT -J/tmp -o /tmp/superlog-fortran-clock sdk/fortran/superlog.F90 demo/fortran/clock.f90 && /tmp/superlog-fortran-clock",
    "tee": "node tailers/bin/superlog-tee.mjs",
    "git": "node tailers/bin/superlog-git.mjs",
    "github": "node tailers/bin/superlog-github.mjs",
    "watch": "node tailers/bin/superlog-watch.mjs",
    "ws": "node tailers/bin/superlog-ws.mjs",
    "serial": "node tailers/bin/superlog-serial.mjs",
    "socket": "node tailers/bin/superlog-socket.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "superlog": "tailers/bin/superlog-tee.mjs",
    "superlog-tee": "tailers/bin/superlog-tee.mjs",
    "superlog-git": "tailers/bin/superlog-git.mjs",
    "superlog-github": "tailers/bin/superlog-github.mjs",
    "superlog-watch": "tailers/bin/superlog-watch.mjs",
    "superlog-log": "tailers/bin/superlog-log",
    "superlog-build": "tailers/bin/superlog-build.mjs",
    "superlog-tail": "tailers/bin/superlog-tail.mjs",
    "superlog-ws": "tailers/bin/superlog-ws.mjs",
    "superlog-serial": "tailers/bin/superlog-serial.mjs",
    "superlog-socket": "tailers/bin/superlog-socket.mjs"
  }
}
